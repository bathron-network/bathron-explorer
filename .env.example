# BATHRON explorer configuration — EXAMPLE ONLY, no real values.
# Install OUTSIDE the webroot, e.g.:
#   sudo install -m 0640 -o root -g www-data .env.example /etc/bathron/explorer-rpc.env
# The tracker's systemd unit loads the same file (EnvironmentFile=).
#
# One codebase can serve several BATHRON chains. Each deployment gets its OWN
# env file, its OWN cache directory and its OWN RPC endpoint — sharing any of
# them between two chains would mix their state.

BATHRON_RPC_HOST=127.0.0.1
BATHRON_RPC_PORT=27175
BATHRON_RPC_USER=explorer
BATHRON_RPC_PASSWORD=REPLACE_WITH_YOUR_RPCAUTH_PASSWORD

# Optional
#BATHRON_DEX_URL=
#BATHRON_STATE_FILE=/var/lib/bathron-explorer/finality.json
#BATHRON_GENESIS_BURNS=

# ── Deployment identity ──────────────────────────────────────────────────────
# Empty label = the public deployment (no banner, no funding panel).
#BATHRON_NETWORK_LABEL=

# The AUTHORITATIVE Bitcoin source network is reported by the node itself
# (getbtcsyncstatus.network — committed by the chain at genesis). The value
# below is only what the UI shows before/without an RPC answer. There is no
# hardcoded fallback: an unknown network yields a neutral label and no link.
#BITCOIN_SOURCE_NETWORK=

# External block explorer, used ONLY for cross-check links — never as a data
# source. Left empty, it is derived from the network above.
#BITCOIN_EXPLORER_BASE=

# Public receive address of a disposable measurement network. Empty = funding
# panel hidden. RECEIVE-ONLY: this application never reaches a spending wallet.
#MEASUREMENT_FUNDING_ADDRESS=
#MEASUREMENT_FUNDING_TARGET_SATS=0

# Per-deployment cache directory (MUST differ between deployments).
#BATHRON_CACHE_DIR=/var/cache/bathron-explorer

# ── Example: measurement network reading Bitcoin Testnet4 (BIP-94) ───────────
#BATHRON_NETWORK_LABEL=Measurement network
#BITCOIN_SOURCE_NETWORK=testnet4
#BITCOIN_EXPLORER_BASE=https://mempool.space/testnet4
#MEASUREMENT_FUNDING_ADDRESS=REPLACE_WITH_PUBLIC_TESTNET4_ADDRESS
#MEASUREMENT_FUNDING_TARGET_SATS=8083000
#BATHRON_CACHE_DIR=/var/cache/bathron-explorer-measurement
#BATHRON_RPC_PORT=REPLACE_WITH_MEASUREMENT_RPC_PORT
