# BATHRON explorer configuration — EXAMPLE ONLY, no real values.
# Install OUTSIDE the webroot, e.g.:
#   sudo install -m 0640 -o root -g www-data .env.example /etc/bathron/explorer-rpc.env
# The tracker's systemd unit loads the same file (EnvironmentFile=).

BATHRON_RPC_HOST=127.0.0.1
BATHRON_RPC_PORT=27175
BATHRON_RPC_USER=explorer
BATHRON_RPC_PASSWORD=REPLACE_WITH_YOUR_RPCAUTH_PASSWORD

# Optional
#BATHRON_DEX_URL=
#BATHRON_STATE_FILE=/var/lib/bathron-explorer/finality.json
#BATHRON_GENESIS_BURNS=
